type = "object"
sequence = 1
rotation = 90.0

[elements.frame]
width_mm = 2.8
height_mm = 10.0
position = "relative"
gap_mm = 0.0
vertical_align = "center"

[elements.layout]
placement = "flow"
width = "fixed"
constrain = true
padding_mm = 0.0

[elements.content_box]
width_mm = 8.0
height_mm = 0.3
offset_x_mm = 0.0
offset_y_mm = 0.0

[elements.content]
type = "line"

[[elements]]
type = "object"
sequence = 1
rotation = 0.0

[elements.frame]
width_mm = 14.5
